# All credentials remain on the server. The app works without them.
GEMINI_API_KEY=
# Set to a model available to your Google AI account.
GEMINI_MODEL=gemini-3.5-flash
RAPIDAPI_KEY=
RAPIDAPI_HOST=free-api-live-football-data.p.rapidapi.com
PORT=3000
# Optional number of trusted reverse-proxy hops (e.g. 1 behind a single proxy).
TRUST_PROXY=0
AI_DAILY_REQUEST_LIMIT=200
# Set your canonical public origin in production (no trailing path).
PUBLIC_ORIGIN=
